FROM rust:1-bookworm AS build
WORKDIR /src
RUN rustup target add wasm32-unknown-unknown && cargo install wasm-pack --version 0.13.1 --locked
COPY . .
ENV CARGO_BUILD_JOBS=2
RUN wasm-pack build crates/canary-wasm --target web --out-dir pkg --release
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY harness ./harness
COPY steam ./steam
COPY --from=build /src/crates/canary-wasm/pkg ./crates/canary-wasm/pkg
ENV PORT=3000
EXPOSE 3000
CMD ["node", "harness/server.mjs"]
